  <section class="card contact">
    <h2>Contato</h2>
    <address>
      <span class="icon-text">
        <i class="iconoir-mail"></i>
        <a href="mailto:email.exemplo@exemplo.com">email.exemplo@exemplo.com</a>
      </span><br>
      <span class="icon-text">
        <i class="iconoir-phone"></i>
        +27 12345-6789
      </span><br>
      <span class="icon-text">
        <i class="iconoir-map-pin"></i>
        Cidade Exemplo, Bairro Exemplo, Número Exemplo
