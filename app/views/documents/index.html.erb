<main class="document-registry-layout">
  <% unless @history_documents.any? || @legal_documents.any? || @other_documents.any? %>
    <p>Não há arquivos registrados.</p>
  <% end %>

  <%= render "document_section", documents: @history_documents, heading: "Históricos" %>
  <%= render "document_section", documents: @legal_documents, heading: "Legais" %>
  <%= render "document_section", documents: @other_documents, heading: "Outros" %>
</main>
