<table class="transfers-table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Título</th>
      <th scope="col" class="description-header">Descrição</th>
      <th scope="col">Valor</th>
      <th scope="col">Data</th>
    </tr>
  </thead>
  <tbody>
    <% transfers.each_with_index do |t, i| %>
      <tr>
        <th scope="row"><%= i + 1 %></th>
        <td><%= t.title %></td>
        <td><%= t.description %></td>
        <td><%= number_to_currency t.amount %></td>
        <td><%= t.created_at.to_fs :date %></td>
      </tr>
    <% end %>
  </tbody>
</table>
